{
  "name": "@lib-core-mfe/module-frontend",
  "version": "0.2.0",
  "description": "React micro-frontends with manifest-based remote module loading and a global browser registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fidelis27/module-frontend.git"
  },
  "homepage": "https://github.com/fidelis27/module-frontend#readme",
  "bugs": {
    "url": "https://github.com/fidelis27/module-frontend/issues"
  },
  "keywords": [
    "micro-frontend",
    "remote-modules",
    "react",
    "module-federation-alternative"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/shared/index.cjs",
  "module": "./dist/shared/index.js",
  "types": "./dist/shared/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.js"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/client/index.d.ts"
      ],
      "server": [
        "dist/server/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,mts}\" \"*.json\" \"*.ts\" \"*.md\" \"docs/**/*.md\" \".github/workflows/*.yml\" \".github/PULL_REQUEST_TEMPLATE/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,mts}\" \"*.json\" \"*.ts\" \"*.md\" \"docs/**/*.md\" \".github/workflows/*.yml\" \".github/PULL_REQUEST_TEMPLATE/*.md\"",
    "check:package": "npm run build && publint && attw --pack . && node -e \"const p=require('./package.json');if(!p.files?.includes('dist')||!require('node:fs').existsSync('dist')){console.error('package.json must include dist in files and dist/ must exist');process.exit(1)}\" && npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  }
}
